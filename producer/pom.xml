<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.aschemann.examples</groupId>
  <artifactId>stubborn-split-producer</artifactId>
  <version>0.0.1-reproducer</version>
  <properties>
    <contracts.mode>LOCAL</contracts.mode>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>sh.stubborn</groupId>
        <artifactId>stubborn-contract-maven-plugin</artifactId>
        <version>0.2.2</version>
        <configuration>
          <contractDependency>
            <groupId>net.aschemann.examples</groupId>
            <artifactId>stubborn-split-contracts</artifactId>
            <version>0.0.1-reproducer</version>
          </contractDependency>
          <contractsPath>contracts</contractsPath>
          <contractsMode>${contracts.mode}</contractsMode>
        </configuration>
        <executions>
          <execution>
            <id>generate-contracts</id>
            <phase>process-test-resources</phase>
            <goals>
              <goal>generateTests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
